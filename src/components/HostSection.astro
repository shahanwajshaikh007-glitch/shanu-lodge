---
---

<section id="host" class="py-24 px-4 sm:px-6 lg:px-8 bg-[#FBF8F3] relative overflow-hidden">
  
  <!-- Subtle ambient background glow -->
  <div class="absolute top-1/2 right-10 w-80 h-80 bg-[#C87A53]/10 rounded-full filter blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto space-y-12">
    
    <div class="bg-[#F3ECE1] border border-[#D9C6B4]/80 rounded-3xl p-8 sm:p-12 shadow-md grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Host Photo -->
      <div class="lg:col-span-5 relative group">
        <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-xl border-4 border-[#FBF8F3] relative">
          <img 
            src="/images/host_shanu.jpg" 
            alt="Shanu, founder and host of Shanu Welcomes Lodge, enjoying tea on the wooden porch" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <!-- Badge -->
          <div class="absolute bottom-4 left-4 right-4 bg-[#2C221E]/90 backdrop-blur-md text-white p-3 rounded-xl shadow-lg border border-white/10 text-center">
            <span class="font-serif-heading text-lg font-bold text-[#E5B899] block">Shanu</span>
            <span class="text-xs text-[#EFE8DC]/80 block">Founder & Resident Host</span>
          </div>
        </div>
      </div>

      <!-- Host Bio & Message -->
      <div class="lg:col-span-7 space-y-6">
        
        <div class="space-y-2">
          <span class="inline-block px-3 py-1 rounded-full bg-[#EFE8DC] text-[#C87A53] text-xs font-semibold uppercase tracking-widest">
            Meet Your Host
          </span>
          <h2 class="font-serif-heading text-3xl sm:text-4xl font-light text-[#2C221E] leading-tight">
            "We Welcome You Not as Guests, But as <span class="italic text-[#C87A53] font-serif-heading">Family</span>."
          </h2>
        </div>

        <blockquote class="font-serif-heading text-lg sm:text-xl font-light italic text-[#6B5B52] border-l-2 border-[#C87A53] pl-4 leading-relaxed">
          "When I built Shanu Lodge amidst these pine valleys, my dream was to create a sanctuary where time stands still. Here, mornings begin with fresh mountain air and piping hot chai, and evenings end by a crackling stone hearth under a blanket of stars."
        </blockquote>

        <p class="text-sm sm:text-base text-[#6B5B52] leading-relaxed">
          Whether you need advice on the best secret hiking trails, a fresh pot of herbal tea after a sunset walk, or a quiet corner with a vinyl record playing, Shanu and our dedicated team are always here to make your stay unforgettable.
        </p>

        <!-- Host Guarantees Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs text-[#2C221E]">
          <div class="bg-[#FBF8F3] p-3.5 rounded-xl border border-[#D9C6B4]/50 flex items-center gap-2.5">
            <span class="text-xl">🫖</span>
            <span>Complimentary Welcome Tea & Snacks</span>
          </div>
          <div class="bg-[#FBF8F3] p-3.5 rounded-xl border border-[#D9C6B4]/50 flex items-center gap-2.5">
            <span class="text-xl">🗺️</span>
            <span>Personalized Trail & Sightseeing Tips</span>
          </div>
          <div class="bg-[#FBF8F3] p-3.5 rounded-xl border border-[#D9C6B4]/50 flex items-center gap-2.5">
            <span class="text-xl">🤝</span>
            <span>24/7 Warm On-Site Host Assistance</span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
