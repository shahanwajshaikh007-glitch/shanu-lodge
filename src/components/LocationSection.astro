---
---

<section id="location" class="py-24 px-4 sm:px-6 lg:px-8 bg-[#FBF8F3] relative">
  <div class="max-w-7xl mx-auto space-y-16">
    
    <!-- Section Header -->
    <div class="text-center space-y-4 max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full bg-[#EFE8DC] text-[#C87A53] text-xs font-semibold uppercase tracking-widest">
        Directions & Map
      </span>
      <h2 class="font-serif-heading text-3xl sm:text-5xl font-light text-[#2C221E] leading-tight">
        Finding Your Way to <span class="italic text-[#C87A53] font-serif-heading">Serenity</span>
      </h2>
      <p class="text-[#6B5B52] text-base sm:text-lg">
        Tucked away in the pine valleys, Shanu Lodge is easily accessible while feeling worlds away from the city noise.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Interactive Location Details & Travel Options -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
        
        <!-- Live Weather Widget -->
        <div class="bg-[#2C221E] text-[#FBF8F3] p-6 rounded-3xl space-y-3 shadow-md">
          <div class="flex items-center justify-between text-xs text-[#E5B899]">
            <span class="uppercase tracking-widest font-semibold">Live Mountain Weather</span>
            <span class="inline-flex items-center gap-1.5 bg-[#4A5D4E]/80 px-2.5 py-0.5 rounded-full text-white">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Live Status
            </span>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <span class="font-serif-heading text-4xl font-light">19°C</span>
              <span class="text-xs text-[#EFE8DC]/80 block">66°F — Soft Mountain Breeze & Mist</span>
            </div>
            <div class="text-4xl">🌤️</div>
          </div>
          <p class="text-xs text-[#EFE8DC]/80 pt-2 border-t border-[#6B5B52]/40">
            Tip: Pack a warm sweater or light jacket for evening fireside stargazing.
          </p>
        </div>

        <!-- Address Card -->
        <div class="bg-[#F3ECE1] border border-[#D9C6B4]/60 p-6 rounded-3xl space-y-4">
          <h3 class="font-serif-heading text-2xl font-bold text-[#2C221E]">Lodge Address</h3>
          <div class="space-y-3 text-sm text-[#6B5B52]">
            <div class="flex items-start gap-3">
              <span class="text-lg">📍</span>
              <div>
                <strong class="text-[#2C221E] block font-medium">Shanu Welcomes Lodge</strong>
                <span>742 Pine Ridge Way, Misty Valley Sanctuary, Mountain Reserve</span>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-lg">📞</span>
              <a href="tel:+18005557426" class="hover:text-[#C87A53] transition">+1 (800) 555-SHANU (7426)</a>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-lg">✉️</span>
              <a href="mailto:stay@shanolodge.com" class="hover:text-[#C87A53] transition">stay@shanulodge.com</a>
            </div>
          </div>
        </div>

        <!-- Travel Guide Accordion -->
        <div class="bg-[#F3ECE1] border border-[#D9C6B4]/60 p-6 rounded-3xl space-y-4">
          <h3 class="font-serif-heading text-xl font-bold text-[#2C221E]">Getting Here</h3>
          
          <div class="space-y-3 text-xs sm:text-sm text-[#6B5B52]">
            <div class="p-3 bg-[#FBF8F3] rounded-2xl border border-[#D9C6B4]/40">
              <strong class="text-[#2C221E] block font-medium">🚗 By Scenic Drive</strong>
              <span>2.5 hours scenic drive from Airport Highway. Free EV charging on site.</span>
            </div>
            <div class="p-3 bg-[#FBF8F3] rounded-2xl border border-[#D9C6B4]/40">
              <strong class="text-[#2C221E] block font-medium">🚂 By Rail & Lodge Shuttle</strong>
              <span>45-minute mountain train to Pine Valley Station. Our electric shuttle picks you up free.</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Map Embed Container -->
      <div class="lg:col-span-7 rounded-3xl overflow-hidden shadow-lg border border-[#D9C6B4]/60 relative min-h-[400px]">
        <iframe 
          title="Shanu Welcomes Lodge Google Map Location"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d100000!2d-121.5!3d44.05!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDTCsDAzJzAwLjAiTiAxMjHCsDMwJzAwLjAiVw!5e0!3m2!1sen!2sus!4v1620000000000!5m2!1sen!2sus" 
          class="w-full h-full min-h-[420px] border-0 grayscale opacity-90 contrast-125"
          allowfullscreen="" 
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        
        <!-- Overlay Card -->
        <div class="absolute bottom-6 left-6 bg-[#2C221E]/90 backdrop-blur-md text-white p-4 rounded-2xl max-w-xs shadow-xl hidden sm:block border border-white/10">
          <span class="text-xs uppercase tracking-widest text-[#E5B899] font-medium block">Exact Coordinates</span>
          <span class="text-sm font-mono block">44°03'00.0"N 121°30'00.0"W</span>
          <span class="text-xs text-[#EFE8DC]/80 mt-1 block">Complimentary Valet & Private Covered Parking</span>
        </div>
      </div>

    </div>

  </div>
</section>
